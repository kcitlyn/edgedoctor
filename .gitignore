# ── OS ─────────────────────────────────────────────
.DS_Store

# ── Python ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ── Logs / scratch ─────────────────────────────────
# Stray logs are ignored, but corpus artifacts and test fixtures ARE the
# product data — they must be committed.
*.log
!corpus/**/*.log
!tests/fixtures/**/*.log

# ── Environment ────────────────────────────────────
.env
.env.local

# ── Build output ───────────────────────────────────
dist/
build/

# ── Model & conversion artifacts (large / regenerable) ──
# These are produced by the pipeline (train → export → convert) and
# should never be committed: they're big, machine-specific, and rebuildable.
*.onnx
*.engine
*.plan
*.trt
*.mlpackage
*.mlmodel
*.tflite
*.pte
*.pt
*.pth
*.ckpt
*.safetensors
weights/
checkpoints/
artifacts/
